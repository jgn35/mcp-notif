# mcp-notif MCP server — Podman/OCI image.
# Apache terminates TLS in front; this container serves plain HTTP on localhost:8080.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# uv for fast, reproducible installs (pinned for reproducibility).
COPY --from=ghcr.io/astral-sh/uv:0.11.15 /uv /usr/local/bin/uv

WORKDIR /app

# Install dependencies first for layer caching.
COPY pyproject.toml ./
RUN uv sync --no-dev --no-install-project

# Copy the application source.
COPY src ./src
RUN uv sync --no-dev

# SQLite token store persists on a volume mount.
VOLUME ["/data"]
ENV TOKEN_DB_PATH=/data/device_token.db

EXPOSE 8080

# Run the ASGI app with uvicorn. Auth tokens + FCM service account are injected
# via environment variables at runtime.
CMD ["uv", "run", "uvicorn", "mcp_notif.app:app", "--host", "0.0.0.0", "--port", "8080"]
