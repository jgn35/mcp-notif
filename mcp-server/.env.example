# MCP server authentication tokens — required.
# Generate strong random strings (e.g. `openssl rand -hex 32`).
MCP_AUTH_TOKEN=
ENROLLMENT_TOKEN=

# FCM_SERVICE_ACCOUNT_PATH is set by compose.yaml (mounted from
# fcm-service-account.json). Override here only if you change the mount.
# FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# SQLite token store path (default shown; rarely changed).
# TOKEN_DB_PATH=/data/device_token.db
